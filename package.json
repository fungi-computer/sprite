{
  "name": "@fungi.computer/sprite",
  "version": "0.0.1",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Typed renderer-bounded presentation for Fungi agents",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js"
    },
    "./mycelium": {
      "types": "./dist/mycelium.d.ts",
      "import": "./dist/mycelium.js"
    },
    "./ink": {
      "types": "./dist/ink.d.ts",
      "import": "./dist/ink.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "lint": "eslint src test vitest.config.ts --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src test vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "docs": "tsx ../../tooling/repository/src/docs/cli.ts check --root ../..",
    "docs:write": "tsx ../../tooling/repository/src/docs/cli.ts write --root ../..",
    "pack": "mkdir -p ../../.botanical/sprite-pack && pnpm pack --pack-destination ../../.botanical/sprite-pack",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(({ createSprite }) => { if (typeof createSprite !== 'function') process.exit(1); })\"",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "workbench:contract": "node scripts/workbench-contract.mjs",
    "workbench:build": "ladle build",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs"
  },
  "dependencies": {
    "effect": "4.0.2",
    "zod": "4.4.3",
    "@fungi.computer/cairn": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ladle/react": "5.1.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "jsdom": "29.0.1",
    "playwright": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/sprite.git"
  }
}
